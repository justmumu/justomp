{
  "inspection_rules": {
    "include": ["**/*"],
    "exclude": ["**/.*", "**/node_modules", "**/venv", "**/bower_components", "**/__pycache__", "**/__pypackages__"]
  },
  "lint": {
    "python": {
      "ruff": {
        "line-length": 120,
        "exclude": [
          ".bzr",
          ".direnv",
          ".eggs",
          ".git",
          ".git-rewrite",
          ".hg",
          ".mypy_cache",
          ".nox",
          ".pants.d",
          ".pytype",
          ".ruff_cache",
          ".svn",
          ".tox",
          ".venv",
          "__pypackages__",
          "_build",
          "buck-out",
          "dist",
          "node_modules",
          "venv"
        ],
        "extend-exclude": [".private"],
        "lint": {
          "select": [
            "F",
            "E",
            "W",
            "B",
            "BLE",
            "RET",
            "PLC",
            "PLE",
            "PLW",
            "UP",
            "I",
            "SIM",
            "C4",
            "C90",
            "PTH",
            "RUF",
            "S",
            "ASYNC",
            "ARG",
            "DTZ",
            "T20",
            "LOG",
            "G",
            "PT",
            "TID",
            "TC",
            "PERF",
            "FBT",
            "N",
            "ANN",
            "T10",
            "SLF",
            "TRY",
            "PIE",
            "ERA",
            "A",
            "PGH",
            "RSE",
            "FURB",
            "INP",
            "EXE",
            "D"
          ],
          "ignore": ["E501", "COM812", "ISC001", "TRY003", "EM101", "EM102", "TID252", "S603", "S607"],
          "per-file-ignores": {
            "tests/*": ["S101", "SLF001", "ARG", "T201", "PT011", "ANN", "INP001", "D"],
            "scripts/*": ["INP001", "T201", "FBT001", "FBT002"]
          },
          "isort": {
            "combine-as-imports": true
          },
          "pydocstyle": {
            "convention": "google"
          }
        },
        "format": {
          "quote-style": "double",
          "indent-style": "space",
          "skip-magic-trailing-comma": false,
          "line-ending": "auto"
        }
      }
    },
    "javascript": {
      "exclude": [],
      "biome": {
        "globals": [
          "console",
          "process",
          "Buffer",
          "global",
          "__dirname",
          "__filename",
          "module",
          "exports",
          "require",
          "setTimeout",
          "clearTimeout",
          "setInterval",
          "clearInterval",
          "setImmediate",
          "clearImmediate",
          "queueMicrotask",
          "structuredClone",
          "fetch",
          "Headers",
          "Request",
          "Response",
          "FormData",
          "URL",
          "URLSearchParams",
          "AbortController",
          "AbortSignal",
          "TextEncoder",
          "TextDecoder",
          "performance",
          "crypto",
          "atob",
          "btoa",
          "window",
          "document",
          "navigator",
          "location",
          "history",
          "localStorage",
          "sessionStorage",
          "alert",
          "confirm",
          "prompt",
          "self",
          "Event",
          "CustomEvent",
          "EventTarget",
          "HTMLElement",
          "Element",
          "Node",
          "File",
          "Blob",
          "FileReader",
          "WebSocket",
          "Worker",
          "MutationObserver",
          "IntersectionObserver",
          "ResizeObserver",
          "requestAnimationFrame",
          "cancelAnimationFrame"
        ],
        "rules": {
          "correctness": {
            "noInvalidConstructorSuper": "error",
            "useValidForDirection": "error",
            "noSwitchDeclarations": "error",
            "noConstAssign": "error",
            "noConstantCondition": "error",
            "noEmptyCharacterClassInRegex": "error",
            "noEmptyPattern": "error",
            "noPrecisionLoss": "error",
            "noInvalidBuiltinInstantiation": "error",
            "noNonoctalDecimalEscape": "error",
            "noGlobalObjectCalls": "error",
            "noSelfAssign": "error",
            "noSetterReturn": "error",
            "noUnreachableSuper": "error",
            "noUndeclaredVariables": "error",
            "noUnreachable": "error",
            "noUnsafeFinally": "error",
            "noUnsafeOptionalChaining": "error",
            "noUnusedLabels": "error",
            "noUnusedPrivateClassMembers": "error",
            "noUnusedVariables": "error",
            "noUnusedImports": "error",
            "noUnusedFunctionParameters": "error",
            "useYield": "error",
            "useIsNan": "error",
            "useValidTypeof": "error"
          },
          "suspicious": {
            "useGetterReturn": "error",
            "noAsyncPromiseExecutor": "error",
            "noClassAssign": "error",
            "noCompareNegZero": "error",
            "noAssignInExpressions": "error",
            "noConstantBinaryExpressions": "error",
            "noControlCharactersInRegex": "error",
            "noDebugger": "error",
            "noDuplicateParameters": "error",
            "noDuplicateClassMembers": "error",
            "noDuplicateElseIf": "error",
            "noDuplicateObjectKeys": "error",
            "noDuplicateCase": "error",
            "noEmptyBlockStatements": "error",
            "noCatchAssign": "error",
            "noFallthroughSwitchClause": "error",
            "noFunctionAssign": "error",
            "noGlobalAssign": "error",
            "noImportAssign": "error",
            "noIrregularWhitespace": "error",
            "noMisleadingCharacterClass": "error",
            "noPrototypeBuiltins": "error",
            "noRedeclare": "error",
            "noShadowRestrictedNames": "error",
            "noSparseArray": "error",
            "noUnsafeNegation": "error",
            "noUselessRegexBackrefs": "error",
            "noUselessEscapeInString": "error",
            "noWith": "error",
            "noDoubleEquals": {
              "level": "error",
              "options": {
                "ignoreNull": false
              }
            },
            "noConsole": {
              "level": "error",
              "options": {
                "allow": ["warn", "error"]
              }
            }
          },
          "performance": {
            "noDelete": "error"
          },
          "complexity": {
            "noExtraBooleanCast": "error",
            "noAdjacentSpacesInRegex": "error",
            "noUselessCatch": "error",
            "noUselessEscapeInRegex": "error",
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 10
              }
            }
          },
          "nursery": {
            "noOctal": "error"
          },
          "style": {
            "useBlockStatements": "error"
          }
        },
        "typed_rules": {
          "correctness": {
            "noInvalidConstructorSuper": "off",
            "noConstAssign": "off",
            "noInvalidBuiltinInstantiation": "off",
            "noGlobalObjectCalls": "off",
            "noSetterReturn": "off",
            "noUnreachableSuper": "off",
            "noUndeclaredVariables": "off",
            "noUnreachable": "off",
            "noUnusedVariables": "error",
            "noUnusedImports": "error",
            "noUnusedFunctionParameters": "error"
          },
          "suspicious": {
            "useGetterReturn": "off",
            "noClassAssign": "off",
            "noDuplicateParameters": "off",
            "noDuplicateClassMembers": "off",
            "noDuplicateObjectKeys": "off",
            "noFunctionAssign": "off",
            "noImportAssign": "off",
            "noRedeclare": "off",
            "noUnsafeNegation": "off",
            "noVar": "error",
            "noWith": "off",
            "noTsIgnore": "error",
            "noDeprecatedImports": "error",
            "noDuplicateEnumValues": "error",
            "noExplicitAny": "error",
            "noExtraNonNullAssertion": "error",
            "noForIn": "error",
            "noConfusingVoidType": "error",
            "noMisleadingInstantiator": "error",
            "noNonNullAssertedOptionalChain": "error",
            "noUnnecessaryConditions": "error",
            "noUnsafeDeclarationMerging": "error",
            "noUnusedExpressions": "error",
            "useNamespaceKeyword": "error",
            "useAwait": "error"
          },
          "style": {
            "useConst": "error",
            "useSpreadOverApply": "error",
            "useArrayLiterals": "error",
            "useConsistentEnumValueType": "error",
            "noNamespace": "error",
            "noNonNullAssertion": "error",
            "noCommonJs": "error",
            "useThrowOnlyError": "error",
            "useAsConstAssertion": "error",
            "useLiteralEnumMembers": "error",
            "useReduceTypeParameter": "error",
            "useUnifiedTypeSignatures": "error",
            "useImportType": {
              "level": "error",
              "options": {
                "style": "inlineType"
              }
            }
          },
          "complexity": {
            "noArguments": "error",
            "noBannedTypes": "error",
            "noStaticOnlyClass": "error",
            "noUselessThisAlias": "error",
            "noUnnecessaryTemplateExpression": "error",
            "noUselessTypeConstraint": "error",
            "noUselessConstructor": "error"
          },
          "nursery": {
            "useAwaitThenable": "error",
            "noBaseToString": "error",
            "noFloatingPromises": "error",
            "noImpliedEval": "error",
            "noMeaninglessVoidOperator": "error",
            "noMisusedPromises": "error",
            "noUselessTypeConversion": "error",
            "noUnsafeReturn": "error",
            "noUnsafeUnaryMinus": "error",
            "usePromiseRejectErrors": "error",
            "noUnsafePlusOperands": "error"
          },
          "performance": {
            "noDelete": "error"
          }
        },
        "test_rules": {
          "suspicious": {
            "noConsole": "off"
          }
        },
        "react_rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
            "useExhaustiveDependencies": "error"
          },
          "a11y": {
            "useAltText": "error",
            "useAnchorContent": "error",
            "useValidAnchor": "error",
            "useAriaActivedescendantWithTabindex": "error",
            "useValidAriaProps": "error",
            "useValidAriaValues": "error",
            "useValidAriaRole": "error",
            "noAriaUnsupportedElements": "error",
            "useValidAutocomplete": "error",
            "useKeyWithClickEvents": "error",
            "useHeadingContent": "error",
            "useHtmlLang": "error",
            "useIframeTitle": "error",
            "noRedundantAlt": "error",
            "useFocusableInteractive": "error",
            "noLabelWithoutControl": "error",
            "useMediaCaption": "error",
            "useKeyWithMouseEvents": "error",
            "noAccessKey": "error",
            "noAutofocus": "error",
            "noDistractingElements": "error",
            "noInteractiveElementToNoninteractiveRole": "error",
            "noNoninteractiveElementInteractions": "error",
            "noNoninteractiveElementToInteractiveRole": "error",
            "noNoninteractiveTabindex": "error",
            "noRedundantRoles": "error",
            "noStaticElementInteractions": "error",
            "useAriaPropsForRole": "error",
            "useAriaPropsSupportedByRole": "error",
            "noHeaderScope": "error",
            "noPositiveTabindex": "error"
          },
          "nursery": {
            "useControlLabel": "off"
          }
        },
        "next_rules": {
          "suspicious": {
            "useGoogleFontDisplay": "error",
            "noDocumentImportInPage": "error",
            "noHeadImportInDocument": "error"
          },
          "performance": {
            "useGoogleFontPreconnect": "error",
            "noImgElement": "error",
            "noSyncScripts": "error",
            "noUnwantedPolyfillio": "error"
          },
          "correctness": {
            "noNextAsyncClientComponent": "error",
            "noBeforeInteractiveScriptOutsideDocument": "error",
            "useInlineScriptId": "error"
          },
          "style": {
            "noHeadElement": "error"
          }
        },
        "organize_imports": "on"
      },
      "prettier": {
        "printWidth": 120,
        "tabWidth": 2,
        "useTabs": false,
        "semi": true,
        "singleQuote": false,
        "trailingComma": "all",
        "endOfLine": "lf"
      }
    },
    "go": {
      "golangci": {
        "severity": {
          "default": "error"
        },
        "linters": {
          "default": "none",
          "enable": [
            "govet",
            "staticcheck",
            "unused",
            "errcheck",
            "errorlint",
            "gosec",
            "bodyclose",
            "contextcheck",
            "exhaustive",
            "revive",
            "gocritic",
            "cyclop"
          ],
          "settings": {
            "errcheck": {
              "check-type-assertions": true,
              "check-blank": true
            },
            "cyclop": {
              "max-complexity": 10
            },
            "exhaustive": {
              "check": ["switch", "mapliteral"]
            }
          },
          "exclusions": {
            "generated": "strict",
            "presets": []
          }
        },
        "formatters": {
          "enable": ["gofumpt", "goimports"],
          "exclusions": {
            "generated": "strict"
          }
        }
      }
    }
  }
}
