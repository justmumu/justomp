{
  "name": "justomp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "files": [
    "src",
    "README.md",
    "docs/inspection.md",
    "docs/protection.md",
    "docs/dependencies.md",
    "docs/lint.md",
    "docs/lint-defaults.json",
    "docs/typecheck.md",
    "docs/typecheck-defaults.json",
    "docs/testing.md",
    "docs/test-defaults.json",
    "docs/integration-test-defaults.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./packaging": "./src/packaging/get-structure.ts",
    "./dependencies": "./src/dependencies/index.ts",
    "./lint": "./src/lint/index.ts",
    "./typecheck": "./src/typecheck/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && biome check . && bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "bench:inspect": "bun tests/performance/inspect.bench.ts",
    "format": "biome check --write .",
    "test:dependencies": "bun test tests/integration/dependencies tests/integration/omp",
    "test:lint": "bun test tests/integration/lint tests/integration/omp/lint.test.ts tests/integration/omp/lint.native.test.ts",
    "test:typecheck": "bun test tests/integration/typecheck tests/integration/omp/typecheck.test.ts tests/integration/omp/typecheck.native.test.ts",
    "test:cost": "bun scripts/test-cost.ts"
  },
  "dependencies": {
    "chokidar": "6.0.0",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "picomatch": "4.0.7"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.13.3"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.13.3",
    "@types/bun": "1.4.4",
    "@types/picomatch": "4.0.2",
    "typescript": "7.0.2",
    "@biomejs/biome": "2.6.3"
  },
  "bin": {
    "justomp-lint": "./src/lint/cli.ts",
    "justomp-typecheck": "./src/typecheck/cli.ts"
  }
}
