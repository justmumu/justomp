{
  "name": "justomp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "files": [
    "src",
    "README.md",
    "docs/inspection.md",
    "docs/protection.md",
    "docs/dependencies.md",
    "docs/format.md",
    "docs/precommit.md",
    "docs/prepush.md",
    "docs/lint.md",
    "docs/lint-migration.md",
    "docs/lint-defaults.json",
    "docs/typecheck.md",
    "docs/typecheck-defaults.json",
    "docs/testing.md",
    "docs/test-defaults.json",
    "docs/integration-test-defaults.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./packaging": "./src/packaging/get-structure.ts",
    "./dependencies": "./src/dependencies/index.ts",
    "./lint": "./src/lint/index.ts",
    "./format": "./src/format/index.ts",
    "./typecheck": "./src/typecheck/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "check": "bun scripts/development.ts check",
    "bench:inspect": "bun tests/performance/inspect.bench.ts",
    "format": "bun scripts/development.ts format",
    "test:dependencies": "bun scripts/development.ts integration --group dependencies",
    "test:lint": "bun scripts/development.ts integration --group lint",
    "test:typecheck": "bun scripts/development.ts integration --group typecheck",
    "test:cost": "bun scripts/test-cost.ts",
    "setup": "bun scripts/development.ts setup",
    "lint": "bun scripts/development.ts lint",
    "lint-fix": "bun scripts/development.ts lint-fix",
    "typecheck": "bun scripts/development.ts typecheck",
    "check:unit": "bun scripts/development.ts test",
    "check:integration": "bun scripts/development.ts integration"
  },
  "dependencies": {
    "@commitlint/lint": "21.2.4",
    "@oh-my-pi/omptype": "18.13.3",
    "chokidar": "6.0.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "picomatch": "4.0.7",
    "prettier": "3.9.10",
    "prettier-plugin-toml": "2.0.6",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.13.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@oh-my-pi/pi-coding-agent": "18.13.3",
    "@types/bun": "1.4.4",
    "@types/picomatch": "4.0.2",
    "typescript": "7.0.2"
  },
  "bin": {
    "justomp-precommit": "./src/precommit/cli.ts",
    "justomp-prepush": "./src/prepush/cli.ts",
    "justomp-lint": "./src/lint/cli.ts",
    "justomp-typecheck": "./src/typecheck/cli.ts"
  }
}
