            "noBannedTypes": "error",
            "noStaticOnlyClass": "error",
            "noUselessThisAlias": "error",
            "noUnnecessaryTemplateExpression": "error",
            "noUselessTypeConstraint": "error",
            "noUselessConstructor": "error"
          },
          "nursery": {
            "useAwaitThenable": "error",
            "noBaseToString": "error",
            "noFloatingPromises": "error",
            "noImpliedEval": "error",
            "noMeaninglessVoidOperator": "error",
            "noMisusedPromises": "error",
            "noUselessTypeConversion": "error",
            "noUnsafeReturn": "error",
            "noUnsafeUnaryMinus": "error",
            "usePromiseRejectErrors": "error",
            "noUnsafePlusOperands": "error"
          },
          "performance": {
            "noDelete": "error"
          }
        },
        "test_rules": {
          "suspicious": {
            "noConsole": "off"
          }
        },
        "react_rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
            "useExhaustiveDependencies": "error"
          },
          "a11y": {
            "useAltText": "error",
            "useAnchorContent": "error",
            "useValidAnchor": "error",
            "useAriaActivedescendantWithTabindex": "error",
            "useValidAriaProps": "error",
            "useValidAriaValues": "error",
            "useValidAriaRole": "error",
            "noAriaUnsupportedElements": "error",
            "useValidAutocomplete": "error",
            "useKeyWithClickEvents": "error",
            "useHeadingContent": "error",
            "useHtmlLang": "error",
            "useIframeTitle": "error",
            "noRedundantAlt": "error",
            "useFocusableInteractive": "error",
            "noLabelWithoutControl": "error",
            "useMediaCaption": "error",
            "useKeyWithMouseEvents": "error",
            "noAccessKey": "error",
            "noAutofocus": "error",
            "noDistractingElements": "error",
            "noInteractiveElementToNoninteractiveRole": "error",
            "noNoninteractiveElementInteractions": "error",
            "noNoninteractiveElementToInteractiveRole": "error",
            "noNoninteractiveTabindex": "error",
            "noRedundantRoles": "error",
            "noStaticElementInteractions": "error",
            "useAriaPropsForRole": "error",
            "useAriaPropsSupportedByRole": "error",
            "noHeaderScope": "error",
            "noPositiveTabindex": "error"
          },
          "nursery": {
            "useControlLabel": "off"
          }
        },
        "next_rules": {
          "suspicious": {
            "useGoogleFontDisplay": "error",
            "noDocumentImportInPage": "error",
            "noHeadImportInDocument": "error"
          },
          "performance": {
            "useGoogleFontPreconnect": "error",
            "noImgElement": "error",
            "noSyncScripts": "error",
            "noUnwantedPolyfillio": "error"
          },
          "correctness": {
            "noNextAsyncClientComponent": "error",
            "noBeforeInteractiveScriptOutsideDocument": "error",
            "useInlineScriptId": "error"
          },
          "style": {
            "noHeadElement": "error"
          }
        },
        "globals": [
          "console",
          "process",
          "Buffer",
          "global",
          "__dirname",
          "__filename",
          "module",
          "exports",
          "require",
          "setTimeout",
          "clearTimeout",
          "setInterval",
          "clearInterval",
          "setImmediate",
          "clearImmediate",
          "queueMicrotask",
          "structuredClone",
          "fetch",
          "Headers",
          "Request",
          "Response",
          "FormData",
          "URL",
          "URLSearchParams",
          "AbortController",
          "AbortSignal",
          "TextEncoder",
          "TextDecoder",
          "performance",
          "crypto",
          "atob",
          "btoa",
          "window",
          "document",
          "navigator",
          "location",
          "history",
          "localStorage",
          "sessionStorage",
          "alert",
          "confirm",
          "prompt",
          "self",
          "Event",
          "CustomEvent",
          "EventTarget",
          "HTMLElement",
          "Element",
          "Node",
          "File",
          "Blob",
          "FileReader",
          "WebSocket",
          "Worker",
          "MutationObserver",
          "IntersectionObserver",
          "ResizeObserver",
          "requestAnimationFrame",
          "cancelAnimationFrame"
        ]
      },
      "exclude": [
        ".private/**"
      ]
    },
    "go": {
      "golangci": {
        "severity": {
          "default": "error"
        },
        "linters": {
          "default": "none",
          "enable": [
            "govet",
            "staticcheck",
            "unused",
            "errcheck",
            "errorlint",
            "gosec",
            "bodyclose",
            "contextcheck",
            "exhaustive",
            "revive",
            "gocritic",
            "cyclop"
          ],
          "settings": {
            "errcheck": {
              "check-type-assertions": true,
              "check-blank": true
            },
            "cyclop": {
              "max-complexity": 10
            },
            "exhaustive": {
              "check": [
                "switch",
                "mapliteral"
              ]
            }
          },
          "exclusions": {
            "generated": "strict",
            "presets": []
          }
        },
        "formatters": {
          "enable": [
            "gofumpt",
            "goimports"
          ],
          "exclusions": {
            "generated": "strict"
          }
        }
      }
    }
  },
  "format": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pypackages__/**",
      "**/.yarn/**",
      "**/.pnpm-store/**",
      "**/.git/**",
      "**/.justomp/**",
      "**/__pycache__/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.next/**",
      "**/.nuxt/**",
      "**/.output/**",
      "**/.turbo/**",
      "**/.cache/**",
      "**/.ruff_cache/**",
      "**/.mypy_cache/**",
      "**/.pytest_cache/**",
      "**/*.tsbuildinfo",
      "**/*.generated.*",
      "**/next-env.d.ts",
      ".private/**",
      ".compound-engineering/artifacts/**"
    ],
    "prettier": {
      "printWidth": 120,
      "tabWidth": 2,
      "useTabs": false,
      "semi": true,
      "singleQuote": false,
      "trailingComma": "all",
      "endOfLine": "lf"
    }
  },
  "typecheck": {
    "python": {
      "pyright": {
        "typeCheckingMode": "strict",
        "diagnostics": {
          "reportImplicitOverride": "error",
          "reportUnnecessaryTypeIgnoreComment": "error",
          "reportMissingTypeStubs": "error"
        }
      }
    },
    "javascript": {
      "compilerOptions": {
        "strict": true,
        "allowJs": true,
        "checkJs": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "skipLibCheck": true
      },
      "exclude": [
        ".private/**"
      ]
    },
    "go": {
      "build_tags": []
    }
  },
  "test": {
    "python": {
      "include": [
        "tests/unit/**/test_*.py"
      ],
      "exclude": [
        "tests/integration/**"
      ],
      "source": {
        "include": [
          "**/*.py"
        ],
        "exclude": [
          "tests/**",
          "**/conftest.py",
          "**/fixtures/**",
          "**/generated/**",
          "**/*_generated.py"
        ]
      },
      "coverage": {
        "enabled": true,
        "minimum": 70
      }
    },
    "javascript": {
      "include": [
        "tests/unit/**/*.test.{js,jsx,ts,tsx}"
      ],
      "exclude": [
        "tests/integration/**"
      ],
      "source": {
        "include": [
          "src/**",
          "scripts/**"
        ],
        "exclude": [
          "tests/**",
          "**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
          "**/*.d.{ts,mts,cts}",
          "**/fixtures/**",
          "**/generated/**",
          "**/*.generated.*",
          "**/*.config.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
          "dist/**",
          "build/**",
          "coverage/**"
        ]
      },
      "coverage": {
        "enabled": true,
        "minimum": 70
      }
    },
    "go": {
      "include": [
        "**/*_test.go"
      ],
      "exclude": [
        "tests/integration/**",
        "**/*_integration_test.go"
      ],
      "source": {
        "include": [
          "**/*.go"
        ],
        "exclude": [
          "**/*_test.go",
          "**/testdata/**",
          "**/generated/**",
          "**/*.generated.go",
          "**/*.pb.go"
        ]
      },
      "coverage": {
        "enabled": true,
        "minimum": 70
      }
    }
  },
  "integration_test": {
    "python": {
      "include": [
        "tests/integration/**/test_*.py"
      ],
      "exclude": [
        "tests/unit/**"
      ],
      "source": {
        "include": [
          "**/*.py"
        ],
        "exclude": [
          "tests/**",
          "**/conftest.py",
          "**/fixtures/**",
          "**/generated/**",
          "**/*_generated.py"
        ]
      },
      "coverage": {
        "enabled": false,
        "minimum": 0
      }
    },
    "javascript": {
      "include": [
        "tests/integration/**/*.test.{js,jsx,ts,tsx}"
      ],
      "exclude": [
        "tests/unit/**"
      ],
      "source": {
        "include": [
          "**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}"
        ],
        "exclude": [
          "tests/**",
          "**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
          "**/*.d.{ts,mts,cts}",
          "**/fixtures/**",
          "**/generated/**",
          "**/*.generated.*",
          "**/*.config.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
          "dist/**",
          "build/**",
          "coverage/**"
        ]
      },
      "coverage": {
        "enabled": false,
        "minimum": 0
      }
    },
    "go": {
      "include": [
        "**/*_integration_test.go"
      ],
      "exclude": [],
      "source": {
        "include": [
          "**/*.go"
        ],
        "exclude": [
          "**/*_test.go",
          "**/testdata/**",
          "**/generated/**",
          "**/*.generated.go",
          "**/*.pb.go"
        ]
      },
      "coverage": {
        "enabled": false,
        "minimum": 0
      }
    }
  },
  "inspection_rules": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "**/.*",
      "**/node_modules",
      "**/venv",
      "**/bower_components",
      "**/__pycache__",
      "**/__pypackages__"
    ]
  },
  "release": {
    "version_file": "VERSION",
    "changelog_file": "CHANGELOG.md",
    "remote": "origin",
    "history_start": null
  }
}
